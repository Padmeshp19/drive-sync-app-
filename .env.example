# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
# Enable "Google Drive API" for your project first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Microsoft OAuth (Azure Portal -> App registrations) ---
# Add API permission: Files.ReadWrite (Microsoft Graph, delegated).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
MS_TENANT=common

# --- App ---
SESSION_SECRET=change-this-to-a-random-string
PORT=3000
